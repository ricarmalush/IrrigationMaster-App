<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodel="clr-namespace:IrrigationMaster.UI.Maui.Features.Level5_Transactions.MyInvoices"
             x:Class="IrrigationMaster.UI.Maui.Features.Level5_Transactions.MyInvoices.MyInvoicesPage"
             x:Name="RootPage"
             Title="Mis Facturas"
             BackgroundColor="{StaticResource AppBackgroundColor}"
             x:DataType="viewmodel:MyInvoicesViewModel">

    <Grid RowDefinitions="Auto,*">

        <ActivityIndicator Grid.Row="0"
                            IsRunning="{Binding IsBusy}"
                            IsVisible="{Binding IsBusy}"
                            Color="{StaticResource AppPrimaryColor}"
                            HeightRequest="30"/>

        <CollectionView Grid.Row="1"
                         ItemsSource="{Binding Invoices}"
                         Margin="10">
            <CollectionView.EmptyView>
                <Label Text="No tienes facturas de licencia individual." HorizontalOptions="Center" Margin="20" TextColor="Gray"/>
            </CollectionView.EmptyView>

            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="viewmodel:InvoiceItem">
                    <Border StrokeThickness="0" BackgroundColor="White" Padding="15" Margin="0,0,0,10">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="12"/>
                        </Border.StrokeShape>
                        <Border.Shadow>
                            <Shadow Brush="Black" Offset="0,2" Opacity="0.1" Radius="5"/>
                        </Border.Shadow>

                        <Grid ColumnDefinitions="*,Auto">
                            <VerticalStackLayout Grid.Column="0" Spacing="4">
                                <Label Text="{Binding InvoiceNumber}" FontSize="15" FontAttributes="Bold" TextColor="Black"/>
                                <Label Text="{Binding IssueDateDisplay}" FontSize="12" TextColor="Gray"/>
                                <Label Text="{Binding AmountDisplay}" FontSize="14" TextColor="#444"/>
                                <Label Text="{Binding Status}" FontSize="12" TextColor="{StaticResource AppPrimaryColor}"/>
                            </VerticalStackLayout>

                            <Button Grid.Column="1"
                                    Text="Comprobante"
                                    IsVisible="{Binding IsPaid}"
                                    Command="{Binding Source={x:Reference RootPage}, Path=BindingContext.DownloadReceiptCommand}"
                                    CommandParameter="{Binding .}"
                                    VerticalOptions="Center"
                                    Style="{StaticResource PrimaryButtonStyle}"/>
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>
