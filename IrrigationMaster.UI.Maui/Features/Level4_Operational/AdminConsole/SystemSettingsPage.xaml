<?xml version="1.0" encoding="utf-8" ?>
<TabbedPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
            xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
            xmlns:viewmodel="clr-namespace:IrrigationMaster.UI.Maui.Features.Level4_Operational.AdminConsole"
            xmlns:resources="clr-namespace:IrrigationMaster.Mobile.Application.Common;assembly=IrrigationMaster.Mobile.Application"
            x:Class="IrrigationMaster.UI.Maui.Features.Level4_Operational.AdminConsole.SystemSettingsPage"
            x:DataType="viewmodel:SystemSettingsViewModel"
            BarBackgroundColor="#2E7D32"
            BarTextColor="White"
            UnselectedTabColor="#A5D6A7"
            SelectedTabColor="White"
            Title="Configuración del Sistema">

    <ContentPage x:Name="EntidadTab" Title="Entidad" BackgroundColor="#F5F5F5">
        <ScrollView Padding="20">
            <VerticalStackLayout Spacing="15">

                <Label Text="MI ORGANIZACIÓN" FontSize="12" FontAttributes="Bold" TextColor="#2E7D32" HorizontalOptions="Center" CharacterSpacing="1.5"/>

                <Border StrokeThickness="0" BackgroundColor="White" Padding="20">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="12"/>
                    </Border.StrokeShape>
                    <Border.Shadow>
                        <Shadow Brush="Black" Offset="0,2" Opacity="0.1" Radius="5"/>
                    </Border.Shadow>

                    <VerticalStackLayout Spacing="15">
                        <Label Text="Nombre:" FontAttributes="Bold" TextColor="#444"/>
                        <Label Text="{Binding MyOrganizationName}" TextColor="Black" FontSize="16"/>

                        <Label Text="Código de invitación (compártelo con nuevos vecinos):" FontAttributes="Bold" TextColor="#444"/>
                        <Entry Text="{Binding MyOrganizationInvitationCode}" IsReadOnly="True" TextColor="Black" BackgroundColor="#FAFAFA" FontAttributes="Bold"/>
                    </VerticalStackLayout>
                </Border>

                <Label Text="ESTRUCTURA LEGAL" FontSize="12" FontAttributes="Bold" TextColor="#2E7D32" HorizontalOptions="Center" CharacterSpacing="1.5" Margin="0,10,0,0"/>
                <Label Text="Entidad Raíz" FontSize="24" FontAttributes="Bold" TextColor="Black" HorizontalOptions="Center"/>

                <Border StrokeThickness="0" BackgroundColor="White" Padding="20">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="12"/>
                    </Border.StrokeShape>
                    <Border.Shadow>
                        <Shadow Brush="Black" Offset="0,2" Opacity="0.1" Radius="5"/>
                    </Border.Shadow>

                    <VerticalStackLayout Spacing="15">
                        <Label Text="Nombre de la Organización:" FontAttributes="Bold" TextColor="#444"/>
                        <Entry Text="{Binding OrgName}" Placeholder="Ej. Regantes El Saso" TextColor="Black" BackgroundColor="#FAFAFA"/>

                        <Label Text="Identificación Fiscal (NIF):" FontAttributes="Bold" TextColor="#444"/>
                        <Entry Text="{Binding OrgTaxId}" Placeholder="Ej. G50123456" TextColor="Black" BackgroundColor="#FAFAFA"/>

                        <Label Text="Dirección Principal:" FontAttributes="Bold" TextColor="#444"/>
                        <Entry Text="{Binding OrgStreet}" Placeholder="Ej. Camino Real s/n" TextColor="Black" BackgroundColor="#FAFAFA"/>

                        <Label Text="Ciudad:" FontAttributes="Bold" TextColor="#444"/>
                        <Entry Text="{Binding OrgCity}" Placeholder="Ej. El Saso" TextColor="Black" BackgroundColor="#FAFAFA"/>

                        <Label Text="Provincia/Estado:" FontAttributes="Bold" TextColor="#444"/>
                        <Entry Text="{Binding OrgStateOrProvince}" Placeholder="Ej. Huesca" TextColor="Black" BackgroundColor="#FAFAFA"/>

                        <Label Text="Código Postal:" FontAttributes="Bold" TextColor="#444"/>
                        <Entry Text="{Binding OrgPostalCode}" Placeholder="Ej. 22300" TextColor="Black" BackgroundColor="#FAFAFA"/>

                        <Label Text="País:" FontAttributes="Bold" TextColor="#444"/>
                        <Picker ItemsSource="{Binding Countries}"
                                ItemDisplayBinding="{Binding Name}"
                                SelectedItem="{Binding SelectedCountry}"
                                Title="Selecciona un país"
                                BackgroundColor="#FAFAFA"/>
                    </VerticalStackLayout>
                </Border>

                <Button Text="💾 Guardar Organización"
                        Command="{Binding SaveOrganizationCommand}"
                        IsEnabled="{Binding IsNotLoading}"
                        BackgroundColor="#2E7D32" TextColor="White" FontAttributes="Bold" HeightRequest="50" CornerRadius="10" Margin="0,10,0,0"/>
            </VerticalStackLayout>
        </ScrollView>
    </ContentPage>

    <ContentPage Title="Sectores" BackgroundColor="#F5F5F5">
        <ScrollView Padding="20">
            <VerticalStackLayout Spacing="15">

                <Label Text="DIVISIÓN GEOGRÁFICA" FontSize="12" FontAttributes="Bold" TextColor="#2E7D32" HorizontalOptions="Center" CharacterSpacing="1.5" Margin="0,10,0,0"/>
                <Label Text="Sectores Hidráulicos" FontSize="24" FontAttributes="Bold" TextColor="Black" HorizontalOptions="Center"/>

                <Border StrokeThickness="0" BackgroundColor="White" Padding="20">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="12"/>
                    </Border.StrokeShape>
                    <Border.Shadow>
                        <Shadow Brush="Black" Offset="0,2" Opacity="0.1" Radius="5"/>
                    </Border.Shadow>

                    <VerticalStackLayout Spacing="15">
                        <Label Text="Nombre del Sector:" FontAttributes="Bold" TextColor="#444"/>
                        <Entry Text="{Binding SectorName}" Placeholder="Ej. Sector Norte" TextColor="Black" BackgroundColor="#FAFAFA"/>

                        <Label Text="Superficie (Hectáreas):" FontAttributes="Bold" TextColor="#444"/>
                        <Entry Text="{Binding SectorAreaSize}" Keyboard="Numeric" Placeholder="Ej. 150.5" TextColor="Black" BackgroundColor="#FAFAFA"/>
                    </VerticalStackLayout>
                </Border>

                <Button Text="💾 Registrar Sector"
                        Command="{Binding SaveHydraulicSectorCommand}"
                        IsEnabled="{Binding IsNotLoading}"
                        BackgroundColor="#2E7D32" TextColor="White" FontAttributes="Bold" HeightRequest="50" CornerRadius="10" Margin="0,10,0,0"/>
            </VerticalStackLayout>
        </ScrollView>
    </ContentPage>

    <ContentPage Title="Andadores" BackgroundColor="#F5F5F5">
        <ScrollView Padding="20">
            <VerticalStackLayout Spacing="15">

                <Label Text="INFRAESTRUCTURA FÍSICA" FontSize="12" FontAttributes="Bold" TextColor="#2E7D32" HorizontalOptions="Center" CharacterSpacing="1.5" Margin="0,10,0,0"/>
                <Label Text="Líneas de Riego" FontSize="24" FontAttributes="Bold" TextColor="Black" HorizontalOptions="Center"/>

                <Border StrokeThickness="0" BackgroundColor="White" Padding="20">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="12"/>
                    </Border.StrokeShape>
                    <Border.Shadow>
                        <Shadow Brush="Black" Offset="0,2" Opacity="0.1" Radius="5"/>
                    </Border.Shadow>

                    <VerticalStackLayout Spacing="15">
                        <Label Text="Código del Andador:" FontAttributes="Bold" TextColor="#444"/>
                        <Entry Text="{Binding WalkwayCode}" Placeholder="Ej. A-01" TextColor="Black" BackgroundColor="#FAFAFA"/>

                        <Label Text="Longitud (Metros):" FontAttributes="Bold" TextColor="#444"/>
                        <Entry Text="{Binding WalkwayLength}" Keyboard="Numeric" Placeholder="Ej. 400.0" TextColor="Black" BackgroundColor="#FAFAFA"/>

                        <Label Text="Sector Hidráulico:" FontAttributes="Bold" TextColor="#444"/>
                        <Picker ItemsSource="{Binding HydraulicSectors}"
                                ItemDisplayBinding="{Binding Name}"
                                SelectedItem="{Binding SelectedHydraulicSector}"
                                Title="Selecciona un sector"
                                BackgroundColor="#FAFAFA"/>
                    </VerticalStackLayout>
                </Border>

                <Button Text="➕ Registrar Andador"
                        Command="{Binding SaveWalkwayCommand}"
                        IsEnabled="{Binding IsNotLoading}"
                        BackgroundColor="#2E7D32" TextColor="White" FontAttributes="Bold" HeightRequest="50" CornerRadius="10" Margin="0,10,0,0"/>
            </VerticalStackLayout>
        </ScrollView>
    </ContentPage>

    <!-- Sin filtro de rol: cualquier usuario autenticado debe poder cambiar su propia
         contraseña, a diferencia de la pestaña "Entidad" (solo SUPERADMIN). -->
    <ContentPage Title="Mi Cuenta" BackgroundColor="#F5F5F5">
        <ScrollView Padding="20">
            <VerticalStackLayout Spacing="15">

                <Label Text="SEGURIDAD DE LA CUENTA" FontSize="12" FontAttributes="Bold" TextColor="#2E7D32" HorizontalOptions="Center" CharacterSpacing="1.5" Margin="0,10,0,0"/>
                <Label Text="Cambiar Contraseña" FontSize="24" FontAttributes="Bold" TextColor="Black" HorizontalOptions="Center"/>

                <Border StrokeThickness="0" BackgroundColor="White" Padding="20">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="12"/>
                    </Border.StrokeShape>
                    <Border.Shadow>
                        <Shadow Brush="Black" Offset="0,2" Opacity="0.1" Radius="5"/>
                    </Border.Shadow>

                    <VerticalStackLayout Spacing="15">
                        <Label Text="Contraseña Actual:" FontAttributes="Bold" TextColor="#444"/>
                        <Entry Text="{Binding CurrentPassword}" IsPassword="True" Placeholder="Tu contraseña actual" TextColor="Black" BackgroundColor="#FAFAFA"/>

                        <Label Text="Nueva Contraseña:" FontAttributes="Bold" TextColor="#444"/>
                        <Entry Text="{Binding NewPassword}" IsPassword="True" Placeholder="Mínimo 8 caracteres" TextColor="Black" BackgroundColor="#FAFAFA"/>

                        <Label Text="Confirmar Nueva Contraseña:" FontAttributes="Bold" TextColor="#444"/>
                        <Entry Text="{Binding ConfirmNewPassword}" IsPassword="True" Placeholder="Repite la nueva contraseña" TextColor="Black" BackgroundColor="#FAFAFA"/>
                    </VerticalStackLayout>
                </Border>

                <Button Text="🔒 Cambiar Contraseña"
                        Command="{Binding ChangePasswordCommand}"
                        IsEnabled="{Binding IsNotLoading}"
                        BackgroundColor="#2E7D32" TextColor="White" FontAttributes="Bold" HeightRequest="50" CornerRadius="10" Margin="0,10,0,0"/>
            </VerticalStackLayout>
        </ScrollView>
    </ContentPage>

</TabbedPage>