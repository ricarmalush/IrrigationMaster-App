<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodel="clr-namespace:IrrigationMaster.UI.Maui.Features.Level4_Operational.AdminConsole"
             x:Class="IrrigationMaster.UI.Maui.Features.Level4_Operational.AdminConsole.SystemSettingsPage"
             x:DataType="viewmodel:SystemSettingsViewModel"
             Title="Configuración del Sistema"
             BackgroundColor="#F5F5F5">
    <!-- Ya no es un TabbedPage: empujar un TabbedPage con Navigation.PushAsync sobre la pila de
         un NavigationPage/Shell revienta en Android (bug de plataforma, reproducido en
         dispositivo real). PushModalAsync evitaba el crash pero deja la página sin la flecha de
         retroceso nativa que Shell añade automáticamente a un push normal, exactamente como en
         UserManagementPage. Un ContentPage normal, empujado igual que UserManagementPage, obtiene
         esa flecha nativa gratis y no tiene el bug del TabbedPage. La tira de pestañas de abajo
         (TabStripGrid) y las 4 Views de contenido (ContentArea) se construyen en el code-behind
         (ver SystemSettingsPage.xaml.cs), condicionadas por rol igual que antes. -->
    <Grid RowDefinitions="Auto,*">
        <Grid x:Name="TabStripGrid" Grid.Row="0" BackgroundColor="#2E7D32" ColumnSpacing="0" HeightRequest="56"/>
        <Grid x:Name="ContentArea" Grid.Row="1"/>
    </Grid>
</ContentPage>
