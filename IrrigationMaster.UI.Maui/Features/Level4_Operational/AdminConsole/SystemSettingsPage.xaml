<?xml version="1.0" encoding="utf-8" ?>
<TabbedPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
            xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
            xmlns:viewmodel="clr-namespace:IrrigationMaster.UI.Maui.Features.Level4_Operational.AdminConsole"
            x:Class="IrrigationMaster.UI.Maui.Features.Level4_Operational.AdminConsole.SystemSettingsPage"
            x:DataType="viewmodel:SystemSettingsViewModel"
            BarBackgroundColor="#2E7D32"
            BarTextColor="White"
            UnselectedTabColor="#A5D6A7"
            SelectedTabColor="White"
            Title="Configuración del Sistema">
    <!-- Sin ContentPage hijas declaradas aquí a propósito: se añaden condicionalmente por rol
         desde el code-behind (Children.Add), nunca se quitan (Children.Remove); ver
         SystemSettingsPage.xaml.cs para la explicación completa del bug de Android que esto
         evita. -->

    <!-- La página se abre con PushModalAsync (no PushAsync; ver AdminMenuPage.xaml.cs), así
         que no hereda la flecha de retroceso automática de la pila de navegación jerárquica.
         Este ToolbarItem es la forma explícita de volver. -->
    <TabbedPage.ToolbarItems>
        <ToolbarItem Text="← Atrás" Order="Primary" Priority="0" Clicked="OnBackClicked"/>
    </TabbedPage.ToolbarItems>
</TabbedPage>
