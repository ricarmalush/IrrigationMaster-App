<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodel="clr-namespace:IrrigationMaster.UI.Maui.Features.Level4_Operational.AdminConsole"
             x:Class="IrrigationMaster.UI.Maui.Features.Level4_Operational.AdminConsole.MiCuentaTabView"
             x:DataType="viewmodel:SystemSettingsViewModel"
             IsVisible="{Binding IsMiCuentaTabActive}"
             BackgroundColor="#F5F5F5">
    <ScrollView Padding="20">
        <VerticalStackLayout Spacing="15">

            <!-- Solo SUPERADMIN, Presidente y VicePresidente (ShowMyOrganization): un Vecino no
                 debe poder ver ni compartir libremente el código de invitación de su
                 organización; a quién se lo comparte lo decide el Presidente/VicePresidente. -->
            <VerticalStackLayout Spacing="15" IsVisible="{Binding ShowMyOrganization}">
                <Label Text="MI ORGANIZACIÓN" FontSize="12" FontAttributes="Bold" TextColor="#2E7D32" HorizontalOptions="Center" CharacterSpacing="1.5"/>

                <Border StrokeThickness="0" BackgroundColor="White" Padding="20">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="12"/>
                    </Border.StrokeShape>
                    <Border.Shadow>
                        <Shadow Brush="Black" Offset="0,2" Opacity="0.1" Radius="5"/>
                    </Border.Shadow>

                    <VerticalStackLayout Spacing="15">
                        <Label Text="Nombre:" FontAttributes="Bold" TextColor="#444"/>
                        <Label Text="{Binding MyOrganizationName}" TextColor="Black" FontSize="16"/>

                        <Label Text="Código de invitación (compártelo con nuevos vecinos):" FontAttributes="Bold" TextColor="#444"/>
                        <Entry Text="{Binding MyOrganizationInvitationCode}" IsReadOnly="True" TextColor="Black" BackgroundColor="#FAFAFA" FontAttributes="Bold"/>

                        <!-- Mismo gating que la sección entera (ShowMyOrganization): el backend
                             (RegenerateInvitationCodeCommandHandler) exige además SUPERADMIN o el
                             permiso MANAGE_ORGANIZATION_CODE, así que esto no es la única defensa. -->
                        <Button Text="🔄 Regenerar código"
                                Command="{Binding RegenerateInvitationCodeCommand}"
                                IsEnabled="{Binding IsNotLoading}"
                                BackgroundColor="Transparent" TextColor="#2E7D32" BorderColor="#2E7D32" BorderWidth="1.5" HeightRequest="44" CornerRadius="10"/>
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>

            <Label Text="SEGURIDAD DE LA CUENTA" FontSize="12" FontAttributes="Bold" TextColor="#2E7D32" HorizontalOptions="Center" CharacterSpacing="1.5" Margin="0,10,0,0"/>
            <Label Text="Cambiar Contraseña" FontSize="24" FontAttributes="Bold" TextColor="Black" HorizontalOptions="Center"/>

            <Border StrokeThickness="0" BackgroundColor="White" Padding="20">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="12"/>
                </Border.StrokeShape>
                <Border.Shadow>
                    <Shadow Brush="Black" Offset="0,2" Opacity="0.1" Radius="5"/>
                </Border.Shadow>

                <VerticalStackLayout Spacing="15">
                    <Label Text="Contraseña Actual:" FontAttributes="Bold" TextColor="#444"/>
                    <Entry Text="{Binding CurrentPassword}" IsPassword="True" Placeholder="Tu contraseña actual" TextColor="Black" BackgroundColor="#FAFAFA"/>

                    <Label Text="Nueva Contraseña:" FontAttributes="Bold" TextColor="#444"/>
                    <Entry Text="{Binding NewPassword}" IsPassword="True" Placeholder="Mínimo 8 caracteres" TextColor="Black" BackgroundColor="#FAFAFA"/>

                    <Label Text="Confirmar Nueva Contraseña:" FontAttributes="Bold" TextColor="#444"/>
                    <Entry Text="{Binding ConfirmNewPassword}" IsPassword="True" Placeholder="Repite la nueva contraseña" TextColor="Black" BackgroundColor="#FAFAFA"/>
                </VerticalStackLayout>
            </Border>

            <Button Text="🔒 Cambiar Contraseña"
                    Command="{Binding ChangePasswordCommand}"
                    IsEnabled="{Binding IsNotLoading}"
                    BackgroundColor="#2E7D32" TextColor="White" FontAttributes="Bold" HeightRequest="50" CornerRadius="10" Margin="0,10,0,0"/>
        </VerticalStackLayout>
    </ScrollView>
</ContentView>
