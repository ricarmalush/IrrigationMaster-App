<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodel="clr-namespace:IrrigationMaster.UI.Maui.Features.Level4_Operational.AdminConsole"
             x:Class="IrrigationMaster.UI.Maui.Features.Level4_Operational.AdminConsole.EntidadTabPage"
             x:DataType="viewmodel:SystemSettingsViewModel"
             Title="Entidad" BackgroundColor="#F5F5F5">
    <ScrollView Padding="20">
        <VerticalStackLayout Spacing="15">

            <Label Text="ESTRUCTURA LEGAL" FontSize="12" FontAttributes="Bold" TextColor="#2E7D32" HorizontalOptions="Center" CharacterSpacing="1.5"/>
            <Label Text="Entidad Raíz" FontSize="24" FontAttributes="Bold" TextColor="Black" HorizontalOptions="Center"/>

            <Border StrokeThickness="0" BackgroundColor="White" Padding="20">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="12"/>
                </Border.StrokeShape>
                <Border.Shadow>
                    <Shadow Brush="Black" Offset="0,2" Opacity="0.1" Radius="5"/>
                </Border.Shadow>

                <VerticalStackLayout Spacing="15">
                    <Label Text="Nombre de la Organización:" FontAttributes="Bold" TextColor="#444"/>
                    <Entry Text="{Binding OrgName}" Placeholder="Ej. Regantes El Saso" TextColor="Black" BackgroundColor="#FAFAFA"/>

                    <Label Text="Identificación Fiscal (NIF):" FontAttributes="Bold" TextColor="#444"/>
                    <Entry Text="{Binding OrgTaxId}" Placeholder="Ej. G50123456" TextColor="Black" BackgroundColor="#FAFAFA"/>

                    <Label Text="Dirección Principal:" FontAttributes="Bold" TextColor="#444"/>
                    <Entry Text="{Binding OrgStreet}" Placeholder="Ej. Camino Real s/n" TextColor="Black" BackgroundColor="#FAFAFA"/>

                    <Label Text="Ciudad:" FontAttributes="Bold" TextColor="#444"/>
                    <Entry Text="{Binding OrgCity}" Placeholder="Ej. El Saso" TextColor="Black" BackgroundColor="#FAFAFA"/>

                    <Label Text="Provincia/Estado:" FontAttributes="Bold" TextColor="#444"/>
                    <Entry Text="{Binding OrgStateOrProvince}" Placeholder="Ej. Huesca" TextColor="Black" BackgroundColor="#FAFAFA"/>

                    <Label Text="Código Postal:" FontAttributes="Bold" TextColor="#444"/>
                    <Entry Text="{Binding OrgPostalCode}" Placeholder="Ej. 22300" TextColor="Black" BackgroundColor="#FAFAFA"/>

                    <Label Text="País:" FontAttributes="Bold" TextColor="#444"/>
                    <Picker ItemsSource="{Binding Countries}"
                            ItemDisplayBinding="{Binding Name}"
                            SelectedItem="{Binding SelectedCountry}"
                            Title="Selecciona un país"
                            BackgroundColor="#FAFAFA"/>
                </VerticalStackLayout>
            </Border>

            <Button Text="💾 Guardar Organización"
                    Command="{Binding SaveOrganizationCommand}"
                    IsEnabled="{Binding IsNotLoading}"
                    BackgroundColor="#2E7D32" TextColor="White" FontAttributes="Bold" HeightRequest="50" CornerRadius="10" Margin="0,10,0,0"/>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
