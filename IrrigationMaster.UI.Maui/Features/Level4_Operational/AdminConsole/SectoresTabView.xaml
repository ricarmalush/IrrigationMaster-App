<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodel="clr-namespace:IrrigationMaster.UI.Maui.Features.Level4_Operational.AdminConsole"
             x:Class="IrrigationMaster.UI.Maui.Features.Level4_Operational.AdminConsole.SectoresTabView"
             x:DataType="viewmodel:SystemSettingsViewModel"
             IsVisible="{Binding IsSectoresTabActive}"
             BackgroundColor="#F5F5F5">
    <ScrollView Padding="20">
        <VerticalStackLayout Spacing="15">

            <Label Text="DIVISIÓN GEOGRÁFICA" FontSize="12" FontAttributes="Bold" TextColor="#2E7D32" HorizontalOptions="Center" CharacterSpacing="1.5" Margin="0,10,0,0"/>
            <Label Text="Sectores Hidráulicos" FontSize="24" FontAttributes="Bold" TextColor="Black" HorizontalOptions="Center"/>

            <Border StrokeThickness="0" BackgroundColor="White" Padding="20">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="12"/>
                </Border.StrokeShape>
                <Border.Shadow>
                    <Shadow Brush="Black" Offset="0,2" Opacity="0.1" Radius="5"/>
                </Border.Shadow>

                <VerticalStackLayout Spacing="15">
                    <Label Text="Nombre del Sector:" FontAttributes="Bold" TextColor="#444"/>
                    <Entry Text="{Binding SectorName}" Placeholder="Ej. Sector Norte" TextColor="Black" BackgroundColor="#FAFAFA"/>

                    <Label Text="Superficie (Hectáreas):" FontAttributes="Bold" TextColor="#444"/>
                    <Entry Text="{Binding SectorAreaSize}" Keyboard="Numeric" Placeholder="Ej. 150.5" TextColor="Black" BackgroundColor="#FAFAFA"/>
                </VerticalStackLayout>
            </Border>

            <Button Text="💾 Registrar Sector"
                    Command="{Binding SaveHydraulicSectorCommand}"
                    IsEnabled="{Binding IsNotLoading}"
                    BackgroundColor="#2E7D32" TextColor="White" FontAttributes="Bold" HeightRequest="50" CornerRadius="10" Margin="0,10,0,0"/>
        </VerticalStackLayout>
    </ScrollView>
</ContentView>
