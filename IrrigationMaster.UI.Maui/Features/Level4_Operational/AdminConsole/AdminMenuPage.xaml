<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="IrrigationMaster.UI.Maui.Features.Level4_Operational.AdminConsole.AdminMenuPage"
             BackgroundColor="#F5F5F5"
             Shell.NavBarIsVisible="False">

    <Grid HorizontalOptions="Center" VerticalOptions="Center">
        <ScrollView>
            <VerticalStackLayout Spacing="15" 
                                 Padding="20" 
                                 WidthRequest="340" 
                                 HorizontalOptions="Center"
                                 VerticalOptions="Center">

                <Label Text="CONSOLA DE CONTROL MAESTRO" FontSize="12" FontAttributes="Bold" TextColor="#2E7D32" HorizontalOptions="Center" CharacterSpacing="1.5"/>
                <Label Text="Gestión Operativa - El Saso" FontSize="20" FontAttributes="Bold" TextColor="Black" HorizontalOptions="Center" Margin="0,0,0,10"/>

                <Label Text="Historial y Estructura" FontSize="13" FontAttributes="Bold" TextColor="Gray" Margin="5,10,0,0"/>

                <Button x:Name="UserManagementButton"
                        Text="🧑‍🤝‍🧑 Gestión de Usuarios y Roles"
                        Clicked="OnUserManagementClicked"
                        IsVisible="False"
                        BackgroundColor="Transparent" TextColor="#2E7D32" BorderColor="#2E7D32" BorderWidth="1.5" HeightRequest="48" CornerRadius="8" />

                <Label Text="Riego" FontSize="13" FontAttributes="Bold" TextColor="Gray" Margin="5,10,0,0"/>

                <!-- Visible para los 3 roles sin restricción: cualquier vecino debe poder ver el
                     estado de riego de su organización. -->
                <Button Text="🚰 Estado de Riego"
                        Clicked="OnIrrigationStatusClicked"
                        BackgroundColor="Transparent" TextColor="#0277BD" BorderColor="#0277BD" BorderWidth="1.5" HeightRequest="48" CornerRadius="8" />

                <Label Text="Ajustes de la Aplicación" FontSize="13" FontAttributes="Bold" TextColor="Gray" Margin="5,10,0,0"/>

                <Button x:Name="SystemSettingsButton"
                        Text="⚙️ Configuración del Sistema" 
                        Clicked="OnSettingsButtonClicked"
                        BackgroundColor="Transparent" 
                        TextColor="#374151" 
                        BorderColor="#374151" 
                        BorderWidth="1.5" 
                        HeightRequest="48" 
                        CornerRadius="8" 
                        FontAttributes="Bold"/>

                <BoxView x:Name="SettingsSeparator" HeightRequest="1" Color="LightGray" Margin="0,10,0,5" />

                <Button Text="Cerrar Consola" 
                        Clicked="OnCloseConsoleClicked"
                        TextColor="Gray" BackgroundColor="Transparent" FontSize="13" HorizontalOptions="Center" />

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>