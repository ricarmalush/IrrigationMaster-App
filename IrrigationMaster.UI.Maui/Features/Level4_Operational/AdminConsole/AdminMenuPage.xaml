<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="IrrigationMaster.UI.Maui.Features.Level4_Operational.AdminConsole.AdminMenuPage"
             BackgroundColor="#F5F5F5"
             Shell.NavBarIsVisible="False">

    <Grid HorizontalOptions="Center" VerticalOptions="Center">
        <ScrollView>
            <VerticalStackLayout Spacing="15" 
                                 Padding="20" 
                                 WidthRequest="340" 
                                 HorizontalOptions="Center"
                                 VerticalOptions="Center">

                <Label Text="CONSOLA DE CONTROL MAESTRO" FontSize="12" FontAttributes="Bold" TextColor="#2E7D32" HorizontalOptions="Center" HorizontalTextAlignment="Center" CharacterSpacing="1.5"/>

                <!-- Texto por defecto sin nombre de organización: OnAppearing lo completa con el
                     nombre real en cuanto GetOrganizationAsync responde (ver BuildHeaderText).
                     HorizontalTextAlignment (no solo HorizontalOptions) es necesario aquí: con un
                     nombre de organización largo el texto envuelve a dos líneas, y sin él cada
                     línea envuelta queda alineada a la izquierda dentro de la etiqueta aunque la
                     etiqueta en sí esté centrada. -->
                <Label x:Name="HeaderTitleLabel" Text="Gestión Operativa" FontSize="20" FontAttributes="Bold" TextColor="Black" HorizontalOptions="Center" HorizontalTextAlignment="Center" Margin="0,0,0,10"/>

                <!-- Único botón bajo esta etiqueta es UserManagementButton, gateado por rol: la
                     etiqueta debe ocultarse junto con él para no quedar huérfana ante un Vecino. -->
                <Label x:Name="HistorialLabel" Text="Historial y Estructura" FontSize="13" FontAttributes="Bold" TextColor="Gray" Margin="5,10,0,0"/>

                <Button x:Name="UserManagementButton"
                        Text="🧑‍🤝‍🧑 Gestión de Usuarios y Roles"
                        Clicked="OnUserManagementClicked"
                        IsVisible="False"
                        BackgroundColor="Transparent" TextColor="#2E7D32" BorderColor="#2E7D32" BorderWidth="1.5" HeightRequest="48" CornerRadius="8" />

                <Label Text="Riego" FontSize="13" FontAttributes="Bold" TextColor="Gray" Margin="5,10,0,0"/>

                <!-- Visible para los 3 roles sin restricción: cualquier vecino debe poder ver el
                     estado de riego de su organización. Mismo texto para todos: para Vecino,
                     OnIrrigationStatusClicked navega directamente a MyIrrigationPage (su propio
                     andador) en vez de IrrigationStatusPage (ver ComputeMenuVisibility). "Mi Riego"
                     (más abajo) se oculta para Vecino por quedar redundante con este destino. -->
                <Button x:Name="IrrigationStatusButton"
                        Text="🚰 Estado de Riego"
                        Clicked="OnIrrigationStatusClicked"
                        BackgroundColor="Transparent" TextColor="#0277BD" BorderColor="#0277BD" BorderWidth="1.5" HeightRequest="48" CornerRadius="8" />

                <!-- Visible para Presidente/Vicepresidente/Coordinador de Riego/SUPERADMIN: oculto
                     para Vecino, para quien "Estado de Riego" ya apunta aquí mismo (ver arriba). -->
                <Button x:Name="MyIrrigationButton"
                        Text="🌊 Mi Riego"
                        Clicked="OnMyIrrigationClicked"
                        BackgroundColor="Transparent" TextColor="#0277BD" BorderColor="#0277BD" BorderWidth="1.5" HeightRequest="48" CornerRadius="8" />

                <!-- Visible solo para Presidente/Vicepresidente/SUPERADMIN (mismo gating que
                     CommunityBroadcastButton): un Vecino puede solicitar su propio turno, pero no
                     aprobar turnos de nadie. -->
                <Button x:Name="ApproveTurnsButton"
                        Text="✅ Aprobar Turnos"
                        Clicked="OnApproveTurnsClicked"
                        IsVisible="False"
                        BackgroundColor="Transparent" TextColor="#0277BD" BorderColor="#0277BD" BorderWidth="1.5" HeightRequest="48" CornerRadius="8" />

                <!-- Visible para SUPERADMIN/Coordinador de Riego (permiso MANAGE_IRRIGATION_PROGRAMS
                     en el backend). Antes exclusivo de SUPERADMIN porque el rol Coordinador todavía
                     no existía. -->
                <Button x:Name="IrrigationProgramsButton"
                        Text="📅 Calendario de Riego"
                        Clicked="OnIrrigationProgramsClicked"
                        IsVisible="False"
                        BackgroundColor="Transparent" TextColor="#0277BD" BorderColor="#0277BD" BorderWidth="1.5" HeightRequest="48" CornerRadius="8" />

                <Label Text="Notificaciones" FontSize="13" FontAttributes="Bold" TextColor="Gray" Margin="5,10,0,0"/>

                <!-- Visible para los 3 roles sin restricción: cualquier usuario debe poder ver
                     sus propias notificaciones. -->
                <Button Text="🔔 Notificaciones"
                        Clicked="OnNotificationsClicked"
                        BackgroundColor="Transparent" TextColor="#8E24AA" BorderColor="#8E24AA" BorderWidth="1.5" HeightRequest="48" CornerRadius="8" />

                <Label Text="Incidencias" FontSize="13" FontAttributes="Bold" TextColor="Gray" Margin="5,10,0,0"/>

                <!-- Visible para los 3 roles sin restricción: el caso principal es el Vecino, pero
                     el backend resuelve permiso y destinatarios por su cuenta. -->
                <Button Text="🚨 Reportar Incidencia"
                        Clicked="OnReportIncidentClicked"
                        BackgroundColor="Transparent" TextColor="#C62828" BorderColor="#C62828" BorderWidth="1.5" HeightRequest="48" CornerRadius="8" />

                <!-- Único botón bajo esta etiqueta es CommunityBroadcastButton, gateado por rol: la
                     etiqueta debe ocultarse junto con él para no quedar huérfana ante un Vecino. -->
                <Label x:Name="AvisosLabel" Text="Avisos" FontSize="13" FontAttributes="Bold" TextColor="Gray" Margin="5,10,0,0"/>

                <!-- Visible solo para Presidente/SUPERADMIN: un Vecino no debe poder enviar avisos
                     masivos, solo incidencias individuales al Presidente. -->
                <Button x:Name="CommunityBroadcastButton"
                        Text="📢 Avisar a mi comunidad"
                        Clicked="OnCommunityBroadcastClicked"
                        IsVisible="False"
                        BackgroundColor="Transparent" TextColor="#EF6C00" BorderColor="#EF6C00" BorderWidth="1.5" HeightRequest="48" CornerRadius="8" />

                <Label Text="Ajustes de la Aplicación" FontSize="13" FontAttributes="Bold" TextColor="Gray" Margin="5,10,0,0"/>

                <Button x:Name="SystemSettingsButton"
                        Text="⚙️ Configuración del Sistema" 
                        Clicked="OnSettingsButtonClicked"
                        BackgroundColor="Transparent" 
                        TextColor="#374151" 
                        BorderColor="#374151" 
                        BorderWidth="1.5" 
                        HeightRequest="48" 
                        CornerRadius="8" 
                        FontAttributes="Bold"/>

                <BoxView x:Name="SettingsSeparator" HeightRequest="1" Color="LightGray" Margin="0,10,0,5" />

                <Button Text="Cerrar Consola" 
                        Clicked="OnCloseConsoleClicked"
                        TextColor="Gray" BackgroundColor="Transparent" FontSize="13" HorizontalOptions="Center" />

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>