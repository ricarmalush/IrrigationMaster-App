<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodel="clr-namespace:IrrigationMaster.UI.Maui.Features.Level4_Operational.Notifications"
             x:Class="IrrigationMaster.UI.Maui.Features.Level4_Operational.Notifications.NotificationsPage"
             x:Name="RootPage"
             Title="Notificaciones"
             BackgroundColor="{StaticResource AppBackgroundColor}"
             x:DataType="viewmodel:NotificationsViewModel">

    <Grid RowDefinitions="Auto,Auto,*">

        <Button Grid.Row="0"
                Text="Marcar todas como leídas"
                Command="{Binding MarkAllAsReadCommand}"
                Style="{StaticResource PrimaryButtonStyle}"
                HeightRequest="44"
                Margin="15,15,15,0"/>

        <ActivityIndicator Grid.Row="1"
                            IsRunning="{Binding IsBusy}"
                            IsVisible="{Binding IsBusy}"
                            Color="{StaticResource AppPrimaryColor}"
                            HeightRequest="30"/>

        <CollectionView Grid.Row="2"
                         ItemsSource="{Binding Notifications}"
                         Margin="10">
            <CollectionView.EmptyView>
                <Label Text="No hay notificaciones que mostrar." HorizontalOptions="Center" Margin="20" TextColor="Gray"/>
            </CollectionView.EmptyView>

            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="viewmodel:NotificationItem">
                    <Border StrokeThickness="0" BackgroundColor="White" Padding="15" Margin="0,0,0,10">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="12"/>
                        </Border.StrokeShape>
                        <Border.Shadow>
                            <Shadow Brush="Black" Offset="0,2" Opacity="0.1" Radius="5"/>
                        </Border.Shadow>
                        <Border.GestureRecognizers>
                            <!-- Tocar una notificación no leída la marca automáticamente (ver
                                 NotificationsViewModel.SelectNotificationAsync); tocar una ya
                                 leída no hace nada. -->
                            <TapGestureRecognizer Command="{Binding Source={x:Reference RootPage}, Path=BindingContext.SelectNotificationCommand}"
                                                   CommandParameter="{Binding .}"/>
                        </Border.GestureRecognizers>

                        <VerticalStackLayout Spacing="4">
                            <HorizontalStackLayout Spacing="6">
                                <!-- Indicador visual de no leída -->
                                <BoxView WidthRequest="10"
                                         HeightRequest="10"
                                         CornerRadius="5"
                                         Color="{StaticResource AppPrimaryColor}"
                                         IsVisible="{Binding IsUnread}"
                                         VerticalOptions="Center"/>

                                <Label Text="{Binding Title}" FontSize="15" TextColor="Black">
                                    <Label.Triggers>
                                        <DataTrigger TargetType="Label" Binding="{Binding IsRead}" Value="True">
                                            <Setter Property="FontAttributes" Value="None"/>
                                            <Setter Property="TextColor" Value="Gray"/>
                                        </DataTrigger>
                                        <DataTrigger TargetType="Label" Binding="{Binding IsRead}" Value="False">
                                            <Setter Property="FontAttributes" Value="Bold"/>
                                            <Setter Property="TextColor" Value="Black"/>
                                        </DataTrigger>
                                    </Label.Triggers>
                                </Label>
                            </HorizontalStackLayout>

                            <Label Text="{Binding Message}" FontSize="14" TextColor="#444">
                                <Label.Triggers>
                                    <DataTrigger TargetType="Label" Binding="{Binding IsRead}" Value="True">
                                        <Setter Property="TextColor" Value="Gray"/>
                                    </DataTrigger>
                                </Label.Triggers>
                            </Label>

                            <Label Text="{Binding CreatedDisplay}" FontSize="11" TextColor="Gray"/>
                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>
