<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodel="clr-namespace:IrrigationMaster.UI.Maui.Features.Level4_Operational.MyIrrigation"
             x:Class="IrrigationMaster.UI.Maui.Features.Level4_Operational.MyIrrigation.MyIrrigationPage"
             x:Name="RootPage"
             Title="Mi Riego"
             BackgroundColor="{StaticResource AppBackgroundColor}"
             x:DataType="viewmodel:MyIrrigationViewModel">

    <Grid RowDefinitions="Auto,*">

        <ActivityIndicator Grid.Row="0"
                            IsRunning="{Binding IsBusy}"
                            IsVisible="{Binding IsBusy}"
                            Color="{StaticResource AppPrimaryColor}"
                            HeightRequest="30"/>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="15" Spacing="15">

                <!-- SIN ANDADOR ASIGNADO: estado válido (p. ej. un Presidente), no un error:
                     mensaje simple en vez de las dos listas. -->
                <Label Text="No tienes andador asignado."
                       IsVisible="{Binding NoWalkwayAssigned}"
                       FontSize="16"
                       TextColor="Gray"
                       HorizontalOptions="Center"
                       Margin="0,40,0,0"/>

                <VerticalStackLayout Spacing="15" IsVisible="{Binding HasWalkway}">
                    <Label FontSize="16" FontAttributes="Bold" TextColor="Black" HorizontalOptions="Center">
                        <Label.FormattedText>
                            <FormattedString>
                                <Span Text="Andador: "/>
                                <Span Text="{Binding WalkwayCode}"/>
                            </FormattedString>
                        </Label.FormattedText>
                    </Label>

                    <!-- ACCIÓN: Solicitar mi turno (solo si hoy no tienes ya ningún turno) -->
                    <Button Text="Solicitar mi turno"
                            Command="{Binding RequestTurnCommand}"
                            IsVisible="{Binding CanRequestTurn}"
                            Style="{StaticResource PrimaryButtonStyle}"
                            HeightRequest="44"/>

                    <!-- SOLICITUDES PARA MAÑANA -->
                    <Label Text="SOLICITUDES PARA MAÑANA" FontSize="12" FontAttributes="Bold" TextColor="{StaticResource AppPrimaryColor}" CharacterSpacing="1.5"/>
                    <Border StrokeThickness="0" BackgroundColor="White" Padding="15">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="12"/>
                        </Border.StrokeShape>
                        <Border.Shadow>
                            <Shadow Brush="Black" Offset="0,2" Opacity="0.1" Radius="5"/>
                        </Border.Shadow>

                        <VerticalStackLayout Spacing="8" BindableLayout.ItemsSource="{Binding RequestsTomorrow}">
                            <BindableLayout.EmptyView>
                                <Label Text="Sin solicitudes para mañana." FontSize="13" TextColor="Gray"/>
                            </BindableLayout.EmptyView>
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="viewmodel:RequestedTurnItem">
                                    <Label FontSize="14" TextColor="#444">
                                        <Label.FormattedText>
                                            <FormattedString>
                                                <Span Text="{Binding FullName}" FontAttributes="Bold"/>
                                                <Span Text=" -- "/>
                                                <Span Text="{Binding ScheduledStartDisplay}"/>
                                            </FormattedString>
                                        </Label.FormattedText>
                                    </Label>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </Border>

                    <!-- RIEGO EN TIEMPO REAL: verde mientras riega, gris cuando ya terminó
                         (DataTrigger sobre IsCompleted: mismo criterio ya usado en
                         UserManagementPage para distinguir "Desactivado"). -->
                    <Label Text="RIEGO EN TIEMPO REAL" FontSize="12" FontAttributes="Bold" TextColor="{StaticResource AppPrimaryColor}" CharacterSpacing="1.5" Margin="0,10,0,0"/>
                    <Border StrokeThickness="0" BackgroundColor="White" Padding="15">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="12"/>
                        </Border.StrokeShape>
                        <Border.Shadow>
                            <Shadow Brush="Black" Offset="0,2" Opacity="0.1" Radius="5"/>
                        </Border.Shadow>

                        <VerticalStackLayout Spacing="8" BindableLayout.ItemsSource="{Binding LiveToday}">
                            <BindableLayout.EmptyView>
                                <Label Text="Sin actividad todavía hoy." FontSize="13" TextColor="Gray"/>
                            </BindableLayout.EmptyView>
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="viewmodel:LiveTurnItem">
                                    <Label FontSize="14" TextColor="{StaticResource AppPrimaryColor}">
                                        <Label.FormattedText>
                                            <FormattedString>
                                                <Span Text="{Binding FullName}" FontAttributes="Bold"/>
                                                <Span Text=" -- "/>
                                                <Span Text="{Binding StatusDisplay}"/>
                                            </FormattedString>
                                        </Label.FormattedText>
                                        <Label.Triggers>
                                            <DataTrigger TargetType="Label" Binding="{Binding IsCompleted}" Value="True">
                                                <Setter Property="TextColor" Value="Gray"/>
                                            </DataTrigger>
                                        </Label.Triggers>
                                    </Label>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
