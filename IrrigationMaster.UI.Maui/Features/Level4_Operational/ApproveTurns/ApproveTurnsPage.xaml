<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodel="clr-namespace:IrrigationMaster.UI.Maui.Features.Level4_Operational.ApproveTurns"
             x:Class="IrrigationMaster.UI.Maui.Features.Level4_Operational.ApproveTurns.ApproveTurnsPage"
             x:Name="RootPage"
             Title="Aprobar Turnos"
             BackgroundColor="{StaticResource AppBackgroundColor}"
             x:DataType="viewmodel:ApproveTurnsViewModel">

    <Grid RowDefinitions="Auto,*">

        <ActivityIndicator Grid.Row="0"
                            IsRunning="{Binding IsBusy}"
                            IsVisible="{Binding IsBusy}"
                            Color="{StaticResource AppPrimaryColor}"
                            HeightRequest="30"/>

        <!-- Agrupado por andador (ya viene así del backend): una tarjeta por andador, con sus
             turnos pendientes dentro ordenados por prioridad. Mismo patrón anidado que
             IrrigationStatusPage (Walkways con Neighbors dentro). -->
        <CollectionView Grid.Row="1"
                         ItemsSource="{Binding Groups}"
                         Margin="10">
            <CollectionView.EmptyView>
                <Label Text="No hay turnos pendientes de aprobar." HorizontalOptions="Center" Margin="20" TextColor="Gray"/>
            </CollectionView.EmptyView>

            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="viewmodel:WalkwayApprovalGroupItem">
                    <Border StrokeThickness="0" BackgroundColor="White" Padding="15" Margin="0,0,0,10">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="12"/>
                        </Border.StrokeShape>
                        <Border.Shadow>
                            <Shadow Brush="Black" Offset="0,2" Opacity="0.1" Radius="5"/>
                        </Border.Shadow>

                        <VerticalStackLayout Spacing="10">
                            <Label FontSize="16" FontAttributes="Bold" TextColor="Black">
                                <Label.FormattedText>
                                    <FormattedString>
                                        <Span Text="Andador: "/>
                                        <Span Text="{Binding WalkwayCode}"/>
                                    </FormattedString>
                                </Label.FormattedText>
                            </Label>

                            <VerticalStackLayout Spacing="8" BindableLayout.ItemsSource="{Binding Turns}">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="viewmodel:PendingTurnItem">
                                        <Border StrokeThickness="0" BackgroundColor="#F5F5F5" Padding="12" Margin="0,4,0,0">
                                            <Border.StrokeShape>
                                                <RoundRectangle CornerRadius="8"/>
                                            </Border.StrokeShape>

                                            <VerticalStackLayout Spacing="6">
                                                <Label FontSize="15" FontAttributes="Bold" TextColor="Black">
                                                    <Label.FormattedText>
                                                        <FormattedString>
                                                            <Span Text="Casa "/>
                                                            <Span Text="{Binding HouseNumberDisplay}"/>
                                                            <Span Text=" -- "/>
                                                            <Span Text="{Binding RequesterFullName}"/>
                                                        </FormattedString>
                                                    </Label.FormattedText>
                                                </Label>
                                                <Label Text="{Binding ScheduleDisplay}" FontSize="13" TextColor="#666"/>

                                                <Button Text="Aprobar turno"
                                                        Command="{Binding Source={x:Reference RootPage}, Path=BindingContext.ApproveCommand}"
                                                        CommandParameter="{Binding .}"
                                                        Style="{StaticResource PrimaryButtonStyle}"
                                                        HeightRequest="40"/>
                                            </VerticalStackLayout>
                                        </Border>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>
