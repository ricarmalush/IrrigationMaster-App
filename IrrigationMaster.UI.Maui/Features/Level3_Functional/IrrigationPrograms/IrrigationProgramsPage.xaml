<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodel="clr-namespace:IrrigationMaster.UI.Maui.Features.Level3_Functional.IrrigationPrograms"
             x:Class="IrrigationMaster.UI.Maui.Features.Level3_Functional.IrrigationPrograms.IrrigationProgramsPage"
             x:Name="RootPage"
             Title="Calendario de Riego"
             BackgroundColor="{StaticResource AppBackgroundColor}"
             x:DataType="viewmodel:IrrigationProgramsViewModel">

    <Grid RowDefinitions="Auto,Auto,*">

        <ActivityIndicator Grid.Row="0"
                            IsRunning="{Binding IsBusy}"
                            IsVisible="{Binding IsBusy}"
                            Color="{StaticResource AppPrimaryColor}"
                            HeightRequest="30"/>

        <!-- FORMULARIO: compartido crear/editar (ver EditingProgramId en el ViewModel).
             HeightRequest fijo: el listado de abajo (Grid.Row="2") necesita su propio espacio
             para desplazarse de forma independiente, sin que un ScrollView "Auto" se lo coma. -->
        <ScrollView Grid.Row="1" HeightRequest="480">
            <VerticalStackLayout Padding="15" Spacing="10">
                <Border StrokeThickness="0" BackgroundColor="White" Padding="15">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="12"/>
                    </Border.StrokeShape>
                    <Border.Shadow>
                        <Shadow Brush="Black" Offset="0,2" Opacity="0.1" Radius="5"/>
                    </Border.Shadow>

                    <VerticalStackLayout Spacing="10">
                        <Label Text="{Binding FormTitle}" FontSize="16" FontAttributes="Bold" TextColor="Black"/>

                        <Label Text="Nombre:" FontSize="13" FontAttributes="Bold" TextColor="#444"/>
                        <Entry Text="{Binding Name}" Placeholder="Ej. Riego matutino Sector Norte" TextColor="Black" BackgroundColor="#FAFAFA"/>

                        <Label Text="Hora de inicio:" FontSize="13" FontAttributes="Bold" TextColor="#444"/>
                        <TimePicker Time="{Binding StartTime}" TextColor="Black" BackgroundColor="#FAFAFA"/>

                        <Label Text="Duración (minutos):" FontSize="13" FontAttributes="Bold" TextColor="#444"/>
                        <Entry Text="{Binding DurationMinutesText}" Keyboard="Numeric" Placeholder="Ej. 90" TextColor="Black" BackgroundColor="#FAFAFA"/>

                        <Label Text="Días (1=Lunes ... 7=Domingo, separados por comas):" FontSize="13" FontAttributes="Bold" TextColor="#444"/>
                        <Entry Text="{Binding DaysOfWeekText}" Placeholder="Ej. 1,3,5" TextColor="Black" BackgroundColor="#FAFAFA"/>

                        <!-- El sector no se puede cambiar al editar: el backend no lo admite en Update. -->
                        <VerticalStackLayout Spacing="4" IsVisible="{Binding CanChangeHydraulicSector}">
                            <Label Text="Sector Hidráulico:" FontSize="13" FontAttributes="Bold" TextColor="#444"/>
                            <Picker ItemsSource="{Binding HydraulicSectors}"
                                    ItemDisplayBinding="{Binding Name}"
                                    SelectedItem="{Binding SelectedHydraulicSector}"
                                    Title="Selecciona un sector"
                                    BackgroundColor="#FAFAFA"/>
                        </VerticalStackLayout>

                        <HorizontalStackLayout Spacing="10" IsVisible="{Binding IsEditing}">
                            <Label Text="Activo:" FontSize="13" FontAttributes="Bold" TextColor="#444" VerticalOptions="Center"/>
                            <Switch IsToggled="{Binding IsActive}"/>
                        </HorizontalStackLayout>

                        <Label Text="Temporada (opcional -- los 4 campos, o ninguno):" FontSize="13" FontAttributes="Bold" TextColor="#444"/>
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                            <Entry Grid.Column="0" Text="{Binding SeasonStartMonthText}" Keyboard="Numeric" Placeholder="Mes inicio (1-12)" TextColor="Black" BackgroundColor="#FAFAFA"/>
                            <Entry Grid.Column="1" Text="{Binding SeasonStartDayText}" Keyboard="Numeric" Placeholder="Día inicio" TextColor="Black" BackgroundColor="#FAFAFA"/>
                        </Grid>
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                            <Entry Grid.Column="0" Text="{Binding SeasonEndMonthText}" Keyboard="Numeric" Placeholder="Mes fin (1-12)" TextColor="Black" BackgroundColor="#FAFAFA"/>
                            <Entry Grid.Column="1" Text="{Binding SeasonEndDayText}" Keyboard="Numeric" Placeholder="Día fin" TextColor="Black" BackgroundColor="#FAFAFA"/>
                        </Grid>

                        <Button Text="{Binding SaveButtonText}"
                                Command="{Binding SaveCommand}"
                                IsEnabled="{Binding IsNotBusy}"
                                BackgroundColor="{StaticResource AppPrimaryColor}" TextColor="White" FontAttributes="Bold" HeightRequest="48" CornerRadius="10" Margin="0,10,0,0"/>

                        <Button Text="Cancelar edición"
                                Command="{Binding CancelEditCommand}"
                                IsVisible="{Binding IsEditing}"
                                BackgroundColor="Transparent" TextColor="Gray" BorderColor="Gray" BorderWidth="1" HeightRequest="44" CornerRadius="10"/>
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>
        </ScrollView>

        <!-- LISTADO -->
        <CollectionView Grid.Row="2"
                         ItemsSource="{Binding Programs}"
                         Margin="10">
            <CollectionView.EmptyView>
                <Label Text="No hay programas de riego registrados todavía." HorizontalOptions="Center" Margin="20" TextColor="Gray"/>
            </CollectionView.EmptyView>

            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="viewmodel:IrrigationProgramListItem">
                    <Border StrokeThickness="0" BackgroundColor="White" Padding="15" Margin="0,0,0,10">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="12"/>
                        </Border.StrokeShape>
                        <Border.Shadow>
                            <Shadow Brush="Black" Offset="0,2" Opacity="0.1" Radius="5"/>
                        </Border.Shadow>

                        <VerticalStackLayout Spacing="4">
                            <Label FontSize="16" FontAttributes="Bold" TextColor="Black">
                                <Label.FormattedText>
                                    <FormattedString>
                                        <Span Text="{Binding Name}"/>
                                        <Span Text=" -- "/>
                                        <Span Text="{Binding StatusDisplay}"/>
                                    </FormattedString>
                                </Label.FormattedText>
                            </Label>
                            <Label FontSize="13" TextColor="#444">
                                <Label.FormattedText>
                                    <FormattedString>
                                        <Span Text="Sector: " FontAttributes="Bold"/>
                                        <Span Text="{Binding HydraulicSectorName}"/>
                                    </FormattedString>
                                </Label.FormattedText>
                            </Label>
                            <Label FontSize="13" TextColor="#444">
                                <Label.FormattedText>
                                    <FormattedString>
                                        <Span Text="Hora: " FontAttributes="Bold"/>
                                        <Span Text="{Binding StartTimeDisplay}"/>
                                        <Span Text=" · Duración: " FontAttributes="Bold"/>
                                        <Span Text="{Binding DurationMinutes}"/>
                                        <Span Text=" min"/>
                                    </FormattedString>
                                </Label.FormattedText>
                            </Label>
                            <Label FontSize="13" TextColor="#444">
                                <Label.FormattedText>
                                    <FormattedString>
                                        <Span Text="Días: " FontAttributes="Bold"/>
                                        <Span Text="{Binding DaysOfWeek}"/>
                                    </FormattedString>
                                </Label.FormattedText>
                            </Label>

                            <Button Text="Editar"
                                    Command="{Binding Source={x:Reference RootPage}, Path=BindingContext.EditProgramCommand}"
                                    CommandParameter="{Binding .}"
                                    BackgroundColor="Transparent"
                                    TextColor="{StaticResource AppPrimaryColor}"
                                    BorderColor="{StaticResource AppPrimaryColor}"
                                    BorderWidth="1.5"
                                    HeightRequest="40"
                                    Margin="0,6,0,0"/>
                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>
