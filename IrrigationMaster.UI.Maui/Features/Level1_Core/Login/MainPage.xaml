<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:IrrigationMaster.UI.Maui.Features.Level1_Core.Login"
             x:Class="IrrigationMaster.UI.Maui.Features.Level1_Core.Login.MainPage"
             BackgroundColor="{StaticResource AppBackgroundColor}"
             Shell.NavBarIsVisible="False"
             x:DataType="local:LoginViewModel">

    <Grid>

        <!-- ScrollView no centra de forma fiable a su contenido en todas las plataformas
             (en Windows/WinUI en particular termina desplazado, no realmente centrado), incluso
             envolviéndolo en un Grid con HorizontalOptions/VerticalOptions="Center". El patrón
             robusto (funciona igual en todas las plataformas) es la rejilla 3x3: filas/columnas
             "*" a los lados absorben todo el espacio sobrante de forma simétrica, dejando la
             celda central (Row=1,Col=1) siempre centrada de verdad. -->
        <ScrollView HorizontalOptions="Fill" VerticalOptions="Fill">
            <Grid HorizontalOptions="Fill" VerticalOptions="Fill"
                  RowDefinitions="*,Auto,*" ColumnDefinitions="*,Auto,*">
                <VerticalStackLayout Grid.Row="1" Grid.Column="1"
                                     Spacing="18"
                                     Padding="20"
                                     WidthRequest="320"
                                     HorizontalOptions="Center"
                                     VerticalOptions="Center">

                    <Label Text="GESTIÓN DE RIEGO"
                           FontSize="18"
                           FontAttributes="Bold"
                           TextColor="Black"
                           HorizontalTextAlignment="Center"
                           HorizontalOptions="Center"
                           Margin="0,10,0,15" />

                    <!-- Logo genérico: el login es previo a la autenticación, así que todavía no
                         se sabe de qué organización es el usuario (ver AdminMenuPage, que sí
                         muestra el nombre real tras el login). -->
                    <Image Source="logo_generic.svg"
                           HeightRequest="110"
                           HorizontalOptions="Center"
                           Margin="0,0,0,5"/>

                    <Label Text="Control de Riego Comunitario"
                           FontSize="20"
                           FontAttributes="Bold"
                           TextColor="{StaticResource AppPrimaryColor}"
                           HorizontalTextAlignment="Center"
                           HorizontalOptions="Center" />

                    <Label Text="Introduce tus credenciales para gestionar la tajadera"
                           FontSize="13"
                           TextColor="Gray"
                           HorizontalTextAlignment="Center"
                           HorizontalOptions="Center"
                           Margin="0,0,0,10" />

                    <VerticalStackLayout Spacing="5" HorizontalOptions="Fill">
                        <Label Text="Correo Electrónico:" Style="{StaticResource FieldLabelStyle}"/>
                        <Entry Text="{Binding Email, Mode=TwoWay}"
                               Placeholder="ejemplo@correo.com"
                               Keyboard="Email"
                               Style="{StaticResource EntryStyle}"/>
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="5" HorizontalOptions="Fill">
                        <Label Text="Contraseña:" Style="{StaticResource FieldLabelStyle}"/>
                        <Entry Text="{Binding Password, Mode=TwoWay}"
                               Placeholder="********"
                               IsPassword="True"
                               Style="{StaticResource EntryStyle}"/>
                    </VerticalStackLayout>

                    <Button Text="Iniciar Sesión"
                            Command="{Binding LoginCommand}"
                            IsEnabled="{Binding IsNotLoading}"
                            Style="{StaticResource PrimaryButtonStyle}"
                            HorizontalOptions="Fill"
                            Margin="0,15,0,0" />

                    <Button Text="¿No tienes cuenta? Regístrate aquí"
                            Command="{Binding NavigateToRegisterCommand}"
                            TextColor="{StaticResource AppSecondaryColor}"
                            BackgroundColor="Transparent"
                            FontSize="13"
                            HorizontalOptions="Center"
                            Margin="0,5,0,0" />

                </VerticalStackLayout>
            </Grid>
        </ScrollView>

        <Grid BackgroundColor="#80FFFFFF"
              IsVisible="{Binding IsLoading}"
              HorizontalOptions="Fill"
              VerticalOptions="Fill">

            <Border BackgroundColor="White"
                    HorizontalOptions="Center"
                    VerticalOptions="Center"
                    WidthRequest="160"
                    Padding="24">

                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="12"/>
                </Border.StrokeShape>

                <Border.Stroke>
                    <SolidColorBrush Color="{StaticResource AppBorderColor}"/>
                </Border.Stroke>

                <Border.Shadow>
                    <Shadow Brush="Black"
                            Offset="0,4"
                            Radius="8"
                            Opacity="0.1" />
                </Border.Shadow>

                <VerticalStackLayout Spacing="12" HorizontalOptions="Center" VerticalOptions="Center">
                    <ActivityIndicator IsRunning="{Binding IsLoading}"
                                       Color="{StaticResource AppPrimaryColor}"
                                       HeightRequest="40"
                                       WidthRequest="40"
                                       HorizontalOptions="Center"/>
                    <Label Text="Conectando..."
                           TextColor="#333333"
                           FontSize="14"
                           FontAttributes="Bold"
                           HorizontalTextAlignment="Center"/>
                </VerticalStackLayout>
            </Border>
        </Grid>

    </Grid>
</ContentPage>
