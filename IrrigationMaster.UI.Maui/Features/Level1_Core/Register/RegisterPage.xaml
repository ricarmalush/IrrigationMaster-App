<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodel="clr-namespace:IrrigationMaster.UI.Maui.Features.Level1_Core.Register"
             x:Class="IrrigationMaster.UI.Maui.Features.Level1_Core.Register.RegisterPage"
             Title="Registro de Vecinos"
             BackgroundColor="{StaticResource AppBackgroundColor}"
             x:DataType="viewmodel:RegisterViewModel">

    <Grid HorizontalOptions="Center" VerticalOptions="Center">
        <ScrollView>
            <VerticalStackLayout Spacing="12"
                                 Padding="20"
                                 WidthRequest="320"
                                 HorizontalOptions="Center"
                                 VerticalOptions="Center">

                <Label x:Name="RegisterTitleLabel"
                       Text="Crear Nueva Cuenta"
                       FontSize="22"
                       FontAttributes="Bold"
                       TextColor="{StaticResource AppPrimaryColor}"
                       HorizontalOptions="Center" />

                <Label x:Name="OrganizationSubtitleLabel"
                       Text="Completa tus datos de acceso"
                       FontSize="13"
                       TextColor="Gray"
                       HorizontalOptions="Center"
                       Margin="0,0,0,5" />

                <VerticalStackLayout Spacing="4">
                    <Label Text="Código de tu comunidad:" Style="{StaticResource FieldLabelStyle}"/>
                    <Entry Text="{Binding InvitationCode}" Placeholder="Código compartido por tu Presidente/Coordinador" Style="{StaticResource EntryStyle}"/>
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="4">
                    <Label Text="Nombre:" Style="{StaticResource FieldLabelStyle}"/>
                    <Entry Text="{Binding FirstName}" Placeholder="Tu nombre" Style="{StaticResource EntryStyle}"/>
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="4">
                    <Label Text="Apellidos:" Style="{StaticResource FieldLabelStyle}"/>
                    <Entry Text="{Binding LastName}" Placeholder="Tus apellidos" Style="{StaticResource EntryStyle}"/>
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="4">
                    <Label Text="Correo Electrónico:" Style="{StaticResource FieldLabelStyle}"/>
                    <Entry Text="{Binding Email}" Placeholder="ejemplo@correo.com" Keyboard="Email" Style="{StaticResource EntryStyle}"/>
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="4">
                    <Label Text="Contraseña:" Style="{StaticResource FieldLabelStyle}"/>
                    <Entry Text="{Binding Password}" Placeholder="********" IsPassword="True" Style="{StaticResource EntryStyle}"/>
                </VerticalStackLayout>

                <Button Text="Confirmar Registro"
                        Command="{Binding RegisterCommand}"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Margin="0,15,0,0" />

                <ActivityIndicator IsRunning="{Binding IsBusy}"
                                   IsVisible="{Binding IsBusy}"
                                   Color="{StaticResource AppPrimaryColor}"
                                   HorizontalOptions="Center" />

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
