<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<!-- net9.0-ios detrás de un opt-in explícito (-p:BuildAllPlatforms=true): Plugin.Firebase.Core/
		     CloudMessaging trajeron los primeros bindings nativos reales de Apple para iOS de este
		     proyecto (GoogleUtilities/GoogleDataTransport/FBLPromises), y un "Compilar solución" sin
		     -f intenta compilar TODOS los TargetFrameworks declarados: ese paso nunca puede
		     terminar en Windows sin un Mac emparejado (agota reintentos copiando xcframeworks/bundles
		     de privacidad). Android es la plataforma decidida ahora; iOS queda para una fase 2
		     explícita, sin bloquear el build diario en Windows. -->
		<TargetFrameworks>net9.0-android</TargetFrameworks>
		<TargetFrameworks Condition="'$(BuildAllPlatforms)' == 'true'">$(TargetFrameworks);net9.0-ios</TargetFrameworks>
		<TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('windows'))">$(TargetFrameworks);net9.0-windows10.0.19041.0</TargetFrameworks>

		<RuntimeIdentifiers Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">android-arm;android-arm64;android-x86;android-x64</RuntimeIdentifiers>

		<OutputType>Exe</OutputType>
		<RootNamespace>IrrigationMaster.UI.Maui</RootNamespace>
		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>

		<LangVersion>preview</LangVersion>

		<ApplicationTitle>IrrigationMaster</ApplicationTitle>

		<!-- Debe coincidir con android_client_info.package_name en google-services.json (Firebase),
		     ya generado para "com.ricarma.irrigationmaster": si difieren, el SDK de Firebase
		     rechaza la configuración en tiempo de ejecución. -->
		<ApplicationId>com.ricarma.irrigationmaster</ApplicationId>

		<ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
		<ApplicationVersion>1</ApplicationVersion>

		<WindowsPackageType>None</WindowsPackageType>

		<NoWarn>$(NoWarn);CA1416</NoWarn>

		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">15.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">21.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</SupportedOSPlatformVersion>
		<TargetPlatformMinVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</TargetPlatformMinVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'tizen'">6.5</SupportedOSPlatformVersion>
	</PropertyGroup>

	<ItemGroup>
		<!-- Icono real de la App (gota) en vez del bot morado de plantilla. Copia propia en
		     Resources\AppIcon (mismo contenido que Resources\Splash\logo_riego_comunitario.svg):
		     el nombre de archivo "appicon" hay que conservarlo porque AndroidManifest.xml/Info.plist/
		     tizen-manifest.xml referencian el icono generado por ese nombre fijo, y además el
		     Resizetizer no admite que dos entradas distintas (MauiIcon/MauiImage) compartan el mismo
		     archivo fuente: deriva el nombre del recurso de salida del nombre de archivo y choca.
		     ForegroundScale="0.65": Android aplica su PROPIO zoom a la capa "foreground" de un icono
		     adaptativo (más allá del margen que ya trae el PNG plano), así que sin encoger aquí el
		     logo sale recortado/demasiado grande en el launcher real, aunque en el PNG generado se
		     vea bien centrado. 0.65 es el valor de referencia habitual para dejarlo dentro de la
		     zona segura tras ese zoom del sistema. -->
		<MauiIcon Include="Resources\AppIcon\appicon.svg" Color="#FFFFFF" ForegroundScale="0.65" />

		<!-- Splash nativo SIN logo a propósito: es el fotograma que el SO pinta en frío, antes de
		     que el código (y por tanto WelcomePage) tome el control: no se puede eliminar del
		     todo, pero si no dibuja nada reconocible, el usuario percibe WelcomePage como la única
		     pantalla real, en vez de "el logo aparece, desaparece y vuelve a aparecer". -->
		<MauiSplashScreen Include="Resources\Splash\blank_splash.svg" Color="#FFFFFF" />

		<!-- Mismo SVG del splash, pero registrado también como MauiImage para poder usarlo con un
		     <Image Source="logo_riego_comunitario.svg"> normal (p. ej. en WelcomePage): el pipeline
		     de MauiSplashScreen es un mecanismo nativo aparte, no expone el asset para uso general. -->
		<MauiImage Include="Resources\Splash\logo_riego_comunitario.svg" />

		<MauiImage Include="Resources\Images\*" />
		<MauiImage Update="Resources\Images\dotnet_bot.png" Resize="True" BaseSize="300,185" />
		
		<MauiFont Include="Resources\Fonts\*" />

		<MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="CommunityToolkit.Maui" Version="11.2.0" />
		<PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.1" />
		<PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
		<PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="9.0.0" />
		<PackageReference Include="Plugin.Firebase.CloudMessaging" Version="4.0.1" />
		<PackageReference Include="Plugin.Firebase.Core" Version="4.2.0" />
	</ItemGroup>

	<!-- Item reconocido por Xamarin.GooglePlayServices.Basement (dependencia transitiva de
	     Plugin.Firebase.CloudMessaging): su target ProcessGoogleServicesJson convierte este archivo
	     en recursos Android (values/goog_svcs_json.xml) en tiempo de build. Firebase.FirebaseOptions
	     no tiene constructor público ni Builder en este binding: el único método público es
	     FromResource(Context), que lee justo esos recursos generados. Solo aplica a Android: el
	     archivo (secreto, ver .gitignore) no existe para los demás TargetFrameworks. -->
	<ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">
		<GoogleServicesJson Include="google-services.json" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\IrrigationMaster.Mobile.Infrastructure\IrrigationMaster.Mobile.Infrastructure.csproj" />
	</ItemGroup>

	<ItemGroup>
		<MauiXaml Update="Features\Level1_Core\Register\RegisterPage.xaml">
			<Generator>MSBuild:Compile</Generator>
		</MauiXaml>
		<MauiXaml Update="Features\Level4_Operational\AdminConsole\AdminMenuPage.xaml">
			<Generator>MSBuild:Compile</Generator>
		</MauiXaml>
		<MauiXaml Update="Features\Level4_Operational\AdminConsole\SystemSettingsPage.xaml">
		  <Generator>MSBuild:Compile</Generator>
		</MauiXaml>
	</ItemGroup>

	<ItemGroup>
		<Folder Include="Features\Level3_Functional\Dashboard\" />
		<Folder Include="Features\Level3_Functional\Queue\" />
		<Folder Include="Features\Level4_Operational\Incidents\" />
		<Folder Include="Features\Level4_Operational\History\" />
	</ItemGroup>

	<ItemGroup>
	  <Compile Update="Common\AppStrings.Designer.cs">
	    <DesignTime>True</DesignTime>
	    <AutoGen>True</AutoGen>
	    <DependentUpon>AppStrings.resx</DependentUpon>
	  </Compile>
	</ItemGroup>

	<ItemGroup>
	  <EmbeddedResource Update="Common\AppStrings.resx">
	    <Generator>PublicResXFileCodeGenerator</Generator>
	    <LastGenOutput>AppStrings.Designer.cs</LastGenOutput>
	  </EmbeddedResource>
	</ItemGroup>

</Project>