<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="IrrigationMaster.UI.Maui.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:login="clr-namespace:IrrigationMaster.UI.Maui.Features.Level1_Core.Login"
    xmlns:welcome="clr-namespace:IrrigationMaster.UI.Maui.Features.Level1_Core.Welcome"
    Title="IrrigationMaster.UI.Maui">

    <!-- Primer ShellContent = página inicial de la app: la bienvenida animada decide sola (según
         haya o no sesión guardada) si navega a Login o a Home, así que ninguna de esas dos debe
         ser ya el punto de entrada. -->
    <ShellContent
        Title="Bienvenida"
        ContentTemplate="{DataTemplate welcome:WelcomePage}"
        Route="WelcomePage" />

    <ShellContent
        Title="Home"
        ContentTemplate="{DataTemplate login:MainPage}"
        Route="MainPage" />

</Shell>